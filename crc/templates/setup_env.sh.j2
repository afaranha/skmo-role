#!/bin/bash
# Environment Setup Script for {{ inventory_hostname }}
# Generated by Ansible CRC role

export PATH=$PATH:{{ crc_install_dir }}

echo "🛠️  Setting up CRC environment..."

# Setup oc environment
eval $({{ crc_install_dir }}/crc oc-env)

# Auto-login
oc login -u kubeadmin -p {{ crc_kubeadmin_password }} https://api.crc.testing:6443 >/dev/null 2>&1

echo "✅ Environment setup complete!"
echo ""
echo "📋 Current context:"
echo "  User: $(oc whoami 2>/dev/null || echo 'Not logged in')"
echo "  Server: $(oc config current-context 2>/dev/null || echo 'No context')"
echo ""

{% if crc_deploy_openstack %}
# Switch to OpenStack namespace
oc project {{ crc_workload_namespace | default('openstack') }} >/dev/null 2>&1
echo "📁 Current namespace: $(oc project -q 2>/dev/null || echo 'default')"
{% endif %}

echo ""
echo "🎯 Ready! You can now use oc commands directly."