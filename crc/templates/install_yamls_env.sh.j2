#!/bin/bash
# Install_yamls Environment Setup Script
# Generated by SKMO automation for {{ inventory_hostname }}
# Following install_yamls official documentation

echo "🚀 Setting up install_yamls environment for {{ inventory_hostname }}..."

# Add install_yamls tools to PATH
export PATH="/home/{{ crc_user }}/bin:$PATH"

# Set CRC environment variables
eval $(crc oc-env) 2>/dev/null || echo "⚠️  CRC not running - start with 'crc start'"

# Change to install_yamls directory
cd {{ crc_openstack_dir }}/install_yamls

# Environment variables for install_yamls
export PULL_SECRET="{{ crc_effective_pull_secret }}"
export CPUS={{ crc_cpus }}
export MEMORY={{ crc_memory }}
export DISK={{ crc_disk_size }}

# OpenStack deployment variables
export OPENSTACK_NAMESPACE="{{ crc_openstack_namespace }}"
export OPENSTACK_REGION="{{ inventory_hostname }}"

echo "✅ Environment configured!"
echo ""
echo "📁 Current directory: $(pwd)"
echo "🔧 CRC status: $(crc status 2>/dev/null || echo 'Not running')"
echo ""
echo "🎯 Available install_yamls commands:"
echo "  make crc_storage      # Configure persistent storage (first time only)"
echo "  make input            # Create input secrets (first time only)"  
echo "  make openstack        # Install OpenStack operators"
echo "  make openstack_deploy # Deploy OpenStack control plane"
echo "  make openstack_init   # Initialize OpenStack services"
echo ""
echo "📊 Monitoring commands:"
echo "  crc console --url     # Get web console URL"
echo "  crc status            # Check CRC status"
echo "  oc get pods -n {{ crc_openstack_namespace }} # Check operator pods"
echo "  oc get csv -n {{ crc_openstack_namespace }}  # Check operator versions"
echo ""
echo "🔐 Authentication:"
echo "  oc login -u kubeadmin # Login to OpenShift (password from 'crc console --credentials')"
echo ""
echo "🌐 Region: {{ inventory_hostname }} ({{ ansible_default_ipv4.address | default('IP not detected') }})"
echo "📋 Namespace: {{ crc_openstack_namespace }}"

# Function to show install_yamls workflow status
install_yamls_status() {
    echo ""
    echo "📋 Install_yamls Workflow Status:"
    echo "=================================="
    
    # Check CRC
    if crc status >/dev/null 2>&1; then
        echo "✅ CRC: Running"
    else
        echo "❌ CRC: Stopped (run 'crc start')"
        return
    fi
    
    # Check if logged in
    if oc whoami >/dev/null 2>&1; then
        echo "✅ OpenShift: Logged in as $(oc whoami)"
    else
        echo "❌ OpenShift: Not logged in (run 'oc login -u kubeadmin')"
    fi
    
    # Check namespace
    if oc get namespace {{ crc_openstack_namespace }} >/dev/null 2>&1; then
        echo "✅ Namespace: {{ crc_openstack_namespace }} exists"
    else
        echo "⚠️  Namespace: {{ crc_openstack_namespace }} not found"
    fi
    
    # Check storage
    pv_count=$(oc get pv 2>/dev/null | grep -c "local-storage" || echo "0")
    if [ "$pv_count" -gt "0" ]; then
        echo "✅ Storage: $pv_count persistent volumes configured"
    else
        echo "⚠️  Storage: No persistent volumes (run 'make crc_storage')"
    fi
    
    # Check secrets
    if oc get secret osp-secret -n {{ crc_openstack_namespace }} >/dev/null 2>&1; then
        echo "✅ Secrets: Input secrets created"
    else
        echo "⚠️  Secrets: Input secrets missing (run 'make input')"
    fi
    
    # Check operators
    csv_count=$(oc get csv -n {{ crc_openstack_namespace }} 2>/dev/null | grep -c "openstack" || echo "0")
    if [ "$csv_count" -gt "0" ]; then
        echo "✅ Operators: $csv_count OpenStack operators installed"
    else
        echo "⚠️  Operators: No OpenStack operators (run 'make openstack')"
    fi
    
    # Check OpenStack deployment
    if oc get openstackcontrolplane -n {{ crc_openstack_namespace }} >/dev/null 2>&1; then
        echo "✅ OpenStack: Control plane deployed"
    else
        echo "⚠️  OpenStack: Control plane not deployed (run 'make openstack_deploy')"
    fi
}

# Export the function so it's available in the shell
export -f install_yamls_status

echo "💡 Type 'install_yamls_status' to check workflow progress"