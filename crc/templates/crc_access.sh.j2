#!/bin/bash
# CRC Access Script for {{ inventory_hostname }}
# Generated by Ansible CRC role

export PATH=$PATH:{{ crc_install_dir }}

echo "🚀 CRC Cluster Access - {{ inventory_hostname }}"
echo "==============================================="

# Setup oc environment
eval $({{ crc_install_dir }}/crc oc-env)

# Display cluster status
echo "📊 Cluster Status:"
{{ crc_install_dir }}/crc status

echo ""
echo "🔑 Credentials:"
{{ crc_install_dir }}/crc console --credentials

echo ""
echo "🌐 Console URL:"
echo "https://console-openshift-console.apps-crc.testing"

echo ""
echo "🔧 Quick Commands:"
echo "  oc get nodes                    # Show cluster nodes"
echo "  oc get pods --all-namespaces    # Show all pods"
echo "  oc project <namespace>          # Switch namespace"
{% if crc_deploy_openstack %}
echo "  oc get pods -n {{ crc_workload_namespace | default('openstack') }}    # OpenStack pods"
{% endif %}

echo ""
echo "💡 To login manually:"
echo "  oc login -u kubeadmin -p {{ crc_kubeadmin_password }} https://api.crc.testing:6443"