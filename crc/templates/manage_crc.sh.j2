#!/bin/bash
# CRC Management Script for {{ inventory_hostname }}
# Generated by Ansible CRC role

export PATH=$PATH:{{ crc_install_dir }}

show_usage() {
    echo "🛠️  CRC Management Script"
    echo "========================"
    echo ""
    echo "Usage: $0 [command]"
    echo ""
    echo "Commands:"
    echo "  start      Start CRC cluster"
    echo "  stop       Stop CRC cluster"
    echo "  restart    Restart CRC cluster"
    echo "  status     Show CRC status"
    echo "  delete     Delete CRC cluster"
    echo "  console    Open web console"
    echo "  info       Show cluster information"
    echo "  logs       Show CRC logs"
}

case "$1" in
    start)
        echo "🚀 Starting CRC cluster..."
        {{ crc_install_dir }}/crc start
        ;;
    stop)
        echo "🛑 Stopping CRC cluster..."
        {{ crc_install_dir }}/crc stop
        ;;
    restart)
        echo "🔄 Restarting CRC cluster..."
        {{ crc_install_dir }}/crc stop
        sleep 5
        {{ crc_install_dir }}/crc start
        ;;
    status)
        echo "📊 CRC Status:"
        {{ crc_install_dir }}/crc status
        ;;
    delete)
        echo "⚠️  This will delete the CRC cluster!"
        read -p "Are you sure? (y/N): " -n 1 -r
        echo
        if [[ $REPLY =~ ^[Yy]$ ]]; then
            {{ crc_install_dir }}/crc delete
        fi
        ;;
    console)
        echo "🌐 Opening web console..."
        {{ crc_install_dir }}/crc console
        ;;
    info)
        echo "ℹ️  Cluster Information:"
        {{ crc_install_dir }}/crc console --credentials
        echo ""
        {{ crc_install_dir }}/crc oc-env
        ;;
    logs)
        echo "📄 CRC Logs:"
        {{ crc_install_dir }}/crc logs
        ;;
    *)
        show_usage
        ;;
esac